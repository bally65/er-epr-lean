+/-! ## The Gamma integral with a complex rate -/
+
+namespace Complex
+
+open Metric
+
+private lemma norm_cpow_mul_cexp_neg_mul {a r : ℂ} {t : ℝ} (ht : 0 < t) :
+    ‖(t : ℂ) ^ (a - 1) * cexp (-(r * t))‖ = t ^ (a.re - 1) * Real.exp (-(r.re * t)) := by
+  rw [norm_mul, norm_cpow_eq_rpow_re_of_pos ht, Complex.norm_exp]
+  simp [Complex.mul_re]
+
+private lemma continuousOn_cpow_mul_cexp_neg_mul (a r : ℂ) :
+    ContinuousOn (fun t : ℝ ↦ (t : ℂ) ^ (a - 1) * cexp (-(r * t))) (Ioi 0) := by
+  intro t ht
+  apply ContinuousAt.continuousWithinAt
+  exact (continuousAt_ofReal_cpow_const t (a - 1) (Or.inr (ne_of_gt ht))).mul
+    (Complex.continuous_exp.comp (by fun_prop : Continuous fun t : ℝ ↦ -(r * (t : ℂ)))).continuousAt
+
+/-- For `0 < a.re` and `0 < r.re`, the function `t ↦ t ^ (a - 1) * exp (-(r * t))` is integrable
+on `Ioi 0`. -/
+lemma integrableOn_cpow_mul_exp_neg_mul_Ioi {a r : ℂ} (ha : 0 < a.re) (hr : 0 < r.re) :
+    IntegrableOn (fun t : ℝ ↦ (t : ℂ) ^ (a - 1) * cexp (-(r * t))) (Ioi 0) := by
+  have hb := integrableOn_rpow_mul_exp_neg_mul_rpow (s := a.re - 1) (p := 1) (b := r.re)
+    (by linarith) one_pos hr
+  refine Integrable.mono' hb
+    ((continuousOn_cpow_mul_cexp_neg_mul a r).aestronglyMeasurable measurableSet_Ioi)
+    (ae_restrict_of_forall_mem measurableSet_Ioi fun t ht ↦ ?_)
+  exact le_of_eq (by rw [norm_cpow_mul_cexp_neg_mul ht, Real.rpow_one, neg_mul])
+
+/-- For `0 < a.re`, the integral `∫ t in Ioi 0, t ^ (a - 1) * exp (-(r * t))` is
+complex-differentiable in `r` on the half-plane `0 < r.re`. -/
+lemma differentiableAt_integral_cpow_mul_exp_neg_mul_Ioi {a r₀ : ℂ} (ha : 0 < a.re)
+    (hr₀ : 0 < r₀.re) :
+    DifferentiableAt ℂ (fun r : ℂ ↦ ∫ t : ℝ in Ioi 0, (t : ℂ) ^ (a - 1) * cexp (-(r * t))) r₀ := by
+  set c := r₀.re / 2 with hc
+  have hc0 : 0 < c := half_pos hr₀
+  have hre : ∀ r ∈ ball r₀ c, c < r.re := by
+    intro r hr
+    rw [mem_ball, dist_eq_norm] at hr
+    have h1 : |(r - r₀).re| ≤ ‖r - r₀‖ := Complex.abs_re_le_norm _
+    rw [Complex.sub_re] at h1
+    have h2 := abs_lt.mp (lt_of_le_of_lt h1 hr)
+    linarith [h2.1, hc]
+  have hbound := integrableOn_rpow_mul_exp_neg_mul_rpow (s := a.re) (p := 1) (b := c)
+    (by linarith) one_pos hc0
+  have hderiv (t : ℝ) (r : ℂ) : HasDerivAt (fun r : ℂ ↦ (t : ℂ) ^ (a - 1) * cexp (-(r * t)))
+      (-(t : ℂ) * ((t : ℂ) ^ (a - 1) * cexp (-(r * t)))) r := by
+    have h0 : HasDerivAt (fun x : ℂ ↦ -(x * (t : ℂ))) (-(t : ℂ)) r :=
+      (hasDerivAt_mul_const (t : ℂ) (x := r)).neg
+    refine (h0.cexp.const_mul ((t : ℂ) ^ (a - 1))).congr_deriv ?_
+    ring
+  have hb : ∀ᵐ (t : ℝ) ∂(volume.restrict (Ioi (0 : ℝ))), ∀ r ∈ ball r₀ c,
+      ‖-(t : ℂ) * ((t : ℂ) ^ (a - 1) * cexp (-(r * t)))‖ ≤
+        t ^ a.re * Real.exp (-c * t ^ (1 : ℝ)) := by
+    refine ae_restrict_of_forall_mem measurableSet_Ioi fun t ht r hr ↦ ?_
+    have ht' : 0 < t := ht
+    rw [norm_mul, norm_neg, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht',
+      norm_cpow_mul_cexp_neg_mul ht', Real.rpow_one]
+    have hpow : t * t ^ (a.re - 1) = t ^ a.re := by
+      rw [Real.rpow_sub_one ht'.ne', mul_div_cancel₀ _ ht'.ne']
+    have hexp : Real.exp (-(r.re * t)) ≤ Real.exp (-c * t) := by
+      apply Real.exp_le_exp.mpr
+      have := hre r hr
+      nlinarith
+    calc t * (t ^ (a.re - 1) * Real.exp (-(r.re * t)))
+        = t ^ a.re * Real.exp (-(r.re * t)) := by rw [← mul_assoc, hpow]
+      _ ≤ t ^ a.re * Real.exp (-c * t) :=
+        mul_le_mul_of_nonneg_left hexp (Real.rpow_nonneg ht'.le _)
+  have hmeas : AEStronglyMeasurable
+      (fun t : ℝ ↦ -(t : ℂ) * ((t : ℂ) ^ (a - 1) * cexp (-(r₀ * t))))
+      (volume.restrict (Ioi (0 : ℝ))) :=
+    ((Complex.continuous_ofReal.neg.continuousOn).mul
+      (continuousOn_cpow_mul_cexp_neg_mul a r₀)).aestronglyMeasurable measurableSet_Ioi
+  exact (hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume.restrict (Ioi (0 : ℝ)))
+    (bound := fun t ↦ t ^ a.re * Real.exp (-c * t ^ (1 : ℝ))) (ball_mem_nhds r₀ hc0)
+    (Eventually.of_forall fun r ↦
+      (continuousOn_cpow_mul_cexp_neg_mul a r).aestronglyMeasurable measurableSet_Ioi)
+    (integrableOn_cpow_mul_exp_neg_mul_Ioi ha hr₀) hmeas hb hbound
+    (ae_of_all _ fun t r _ ↦ hderiv t r)).2.differentiableAt
+
+/-- Expresses the integral over `Ioi 0` of `t ^ (a - 1) * exp (-(r * t))` in terms of the Gamma
+function, for complex `a` and `r` with positive real parts. This generalizes
+`Complex.integral_cpow_mul_exp_neg_mul_Ioi`, where `r` is a positive real number; the proof
+extends that case to the half-plane `0 < r.re` by the identity theorem. -/
+theorem integral_cpow_mul_exp_neg_mul_Ioi_of_re_pos {a r : ℂ} (ha : 0 < a.re) (hr : 0 < r.re) :
+    ∫ t : ℝ in Ioi 0, (t : ℂ) ^ (a - 1) * cexp (-(r * t)) = (1 / r) ^ a * Gamma a := by
+  have hU : IsOpen {z : ℂ | 0 < z.re} := isOpen_lt continuous_const Complex.continuous_re
+  have hF : AnalyticOnNhd ℂ (fun z : ℂ ↦ ∫ t : ℝ in Ioi 0, (t : ℂ) ^ (a - 1) * cexp (-(z * t)))
+      {z : ℂ | 0 < z.re} :=
+    DifferentiableOn.analyticOnNhd
+      (fun z hz ↦ (differentiableAt_integral_cpow_mul_exp_neg_mul_Ioi ha hz).differentiableWithinAt)
+      hU
+  have hG : AnalyticOnNhd ℂ (fun z : ℂ ↦ (1 / z) ^ a * Gamma a) {z : ℂ | 0 < z.re} := by
+    refine DifferentiableOn.analyticOnNhd (fun z hz ↦ ?_) hU
+    have hz' : 0 < z.re := hz
+    have hz0 : z ≠ 0 := fun h ↦ by rw [h, Complex.zero_re] at hz'; exact lt_irrefl 0 hz'
+    have hslit : 1 / z ∈ slitPlane := by
+      rw [Complex.mem_slitPlane_iff]
+      left
+      rw [one_div, Complex.inv_re]
+      exact div_pos hz' (Complex.normSq_pos.mpr hz0)
+    have hinv : DifferentiableAt ℂ (fun z : ℂ ↦ 1 / z) z := by
+      simp only [one_div]
+      exact differentiableAt_inv hz0
+    exact ((hinv.cpow_const hslit).mul_const _).differentiableWithinAt
+  have hU' : IsPreconnected {z : ℂ | 0 < z.re} := (convex_halfSpace_re_gt (r := 0)).isPreconnected
+  have h1 : (1 : ℂ) ∈ {z : ℂ | 0 < z.re} := by simp
+  -- the real sequence `1 + 1 / (n + 1)` accumulates at `1`, where both sides agree by
+  -- `integral_cpow_mul_exp_neg_mul_Ioi`
+  have hseq : Tendsto (fun n : ℕ ↦ (((1 : ℝ) + 1 / ((n : ℝ) + 1) : ℝ) : ℂ)) atTop
+      (𝓝[≠] (1 : ℂ)) := by
+    refine tendsto_nhdsWithin_iff.mpr ⟨?_, Eventually.of_forall fun n ↦ ?_⟩
+    · have h0 : Tendsto (fun n : ℕ ↦ (1 : ℝ) + 1 / ((n : ℝ) + 1)) atTop (𝓝 (1 + 0)) :=
+        tendsto_const_nhds.add tendsto_one_div_add_atTop_nhds_zero_nat
+      rw [add_zero] at h0
+      have := (Complex.continuous_ofReal.tendsto 1).comp h0
+      rw [Complex.ofReal_one] at this
+      exact this
+    · rw [Set.mem_compl_iff, Set.mem_singleton_iff]
+      intro h
+      have h' := Complex.ofReal_injective (h.trans Complex.ofReal_one.symm)
+      have hpos : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
+      linarith
+  have hfreq : ∃ᶠ z in 𝓝[≠] (1 : ℂ),
+      (fun z : ℂ ↦ ∫ t : ℝ in Ioi 0, (t : ℂ) ^ (a - 1) * cexp (-(z * t))) z =
+        (fun z : ℂ ↦ (1 / z) ^ a * Gamma a) z :=
+    hseq.frequently (Frequently.of_forall fun n ↦
+      integral_cpow_mul_exp_neg_mul_Ioi ha (by positivity))
+  exact hF.eqOn_of_preconnected_of_frequently_eq hG hU' h1 hfreq hr
+
+end Complex
